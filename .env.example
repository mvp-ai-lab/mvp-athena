NODE_ENV=development
PORT=3000
ATHENA_API_URL=http://127.0.0.1:3000
ATHENA_TOKEN=dev-token
ATHENA_STORAGE_MODE=memory
ATHENA_DEFAULT_USER_ID=dev-user
ATHENA_TRUSTED_USER_HEADER=false

# GitHub integration, required when ATHENA_STORAGE_MODE=postgres.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_INSTALLATION_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Optional: automatically grant newly logged-in GitHub users access to one space.
ATHENA_SIGNUP_SPACE_ID=
ATHENA_SIGNUP_ROLE=viewer

# Discord bot entrypoint.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Persistence/search infrastructure, required when ATHENA_STORAGE_MODE=postgres.
DATABASE_URL=postgres://athena:athena@localhost:5432/athena
REDIS_URL=redis://localhost:6379

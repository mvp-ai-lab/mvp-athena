NODE_ENV=development
PORT=3000
ATHENA_API_PORT=3000
ATHENA_API_BIND=
ATHENA_API_URL=http://127.0.0.1:3000
ATHENA_STORAGE_MODE=memory
ATHENA_BODY_LIMIT_BYTES=10485760
ATHENA_API_TOKEN_TTL_DAYS=30

# PostgreSQL, required when ATHENA_STORAGE_MODE=postgres.
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena
POSTGRES_DB=athena
DATABASE_URL=postgres://athena:athena@postgres:5432/athena

# GitHub knowledge repository, required when ATHENA_STORAGE_MODE=postgres.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=

# GitHub App, required when ATHENA_STORAGE_MODE=postgres.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_HOST_PATH=

# Optional: automatically grant repo-authorized GitHub users access to one space.
# If ATHENA_SIGNUP_ROLE is empty, Athena mirrors the user's GitHub repository permission.
# If ATHENA_SIGNUP_ROLE is set, it is treated as the maximum auto-granted role.
ATHENA_SIGNUP_SPACE_ID=
ATHENA_SIGNUP_ROLE=

# Discord bot entrypoint.
ATHENA_BOT_TOKEN=
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
